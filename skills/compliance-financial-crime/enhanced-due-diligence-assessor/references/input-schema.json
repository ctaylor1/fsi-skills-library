{
  "type": "object",
  "required": [
    "request_id",
    "object_id",
    "object_type",
    "as_of",
    "knowledge_cutoff",
    "workflow",
    "sources",
    "data",
    "mode"
  ],
  "properties": {
    "request_id": {
      "type": "string"
    },
    "object_id": {
      "type": "string"
    },
    "object_type": {
      "type": "string",
      "const": "customer"
    },
    "as_of": {
      "type": "string"
    },
    "knowledge_cutoff": {
      "type": "string"
    },
    "execution_context": {
      "type": "string"
    },
    "workflow": {
      "type": "object",
      "required": [
        "context",
        "as_of",
        "role",
        "classification",
        "audience",
        "allowed_audiences",
        "sources",
        "unresolved_issues"
      ],
      "properties": {
        "context": {
          "type": "object",
          "required": [
            "institution_id",
            "legal_entity_id",
            "capacity",
            "represented_party",
            "object_id",
            "object_type",
            "jurisdiction",
            "line_of_business",
            "purpose"
          ],
          "properties": {
            "institution_id": {
              "type": "string"
            },
            "legal_entity_id": {
              "type": "string"
            },
            "capacity": {
              "type": "string"
            },
            "represented_party": {
              "type": "string"
            },
            "object_id": {
              "type": "string"
            },
            "object_type": {
              "type": "string"
            },
            "jurisdiction": {
              "type": "string"
            },
            "line_of_business": {
              "type": "string"
            },
            "purpose": {
              "type": "string"
            }
          }
        },
        "as_of": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "classification": {
          "type": "string"
        },
        "audience": {
          "type": "string"
        },
        "allowed_audiences": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "source_ref",
              "version"
            ],
            "properties": {
              "source_ref": {
                "type": "string"
              },
              "version": {
                "type": "string"
              }
            }
          }
        },
        "unresolved_issues": {
          "type": "array",
          "items": {}
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_ref",
          "version",
          "received_at",
          "publication_date",
          "classification",
          "permitted_audiences",
          "facts"
        ],
        "properties": {
          "source_ref": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "received_at": {
            "type": "string"
          },
          "publication_date": {
            "type": "string"
          },
          "classification": {
            "type": "string"
          },
          "permitted_audiences": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "facts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "fact_id",
                "value",
                "excerpt"
              ],
              "properties": {
                "fact_id": {
                  "type": "string"
                },
                "value": {
                  "type": [
                    "null",
                    "boolean",
                    "object",
                    "array",
                    "number",
                    "string"
                  ],
                  "description": "Actual finite JSON fact value, preserving its source type; native common validation rejects nonfinite numbers."
                },
                "excerpt": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "data": {
      "type": "object",
      "required": [
        "wealth_funds_claims",
        "hypotheses",
        "controls",
        "chronology"
      ],
      "properties": {
        "wealth_funds_claims": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "claim_id",
              "kind",
              "currency",
              "currency_evidence",
              "claimed_amount",
              "claim_date",
              "corroboration",
              "counterevidence",
              "economic_activity",
              "capacity_basis",
              "capacity_currency",
              "economic_capacity"
            ],
            "properties": {
              "claim_id": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "currency": {
                "type": "string"
              },
              "currency_evidence": {
                "$ref": "#/$defs/claim"
              },
              "claimed_amount": {
                "$ref": "#/$defs/claim"
              },
              "claim_date": {
                "$ref": "#/$defs/claim"
              },
              "corroboration": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "evidence_id",
                    "amount",
                    "date",
                    "currency",
                    "currency_evidence",
                    "description"
                  ],
                  "properties": {
                    "evidence_id": {
                      "type": "string"
                    },
                    "amount": {
                      "$ref": "#/$defs/claim"
                    },
                    "date": {
                      "$ref": "#/$defs/claim"
                    },
                    "currency": {
                      "type": "string"
                    },
                    "currency_evidence": {
                      "$ref": "#/$defs/claim"
                    },
                    "description": {
                      "$ref": "#/$defs/claim"
                    },
                    "economic_event": {
                      "$ref": "#/$defs/claim",
                      "description": "Known value must source-bind event_id, claim_id, amount, currency and date. Document/fact identity alone cannot establish economic distinctness."
                    }
                  }
                }
              },
              "counterevidence": {
                "type": "array",
                "items": {}
              },
              "economic_activity": {
                "$ref": "#/$defs/claim"
              },
              "capacity_basis": {
                "$ref": "#/$defs/claim"
              },
              "capacity_currency": {
                "$ref": "#/$defs/claim"
              },
              "economic_capacity": {
                "$ref": "#/$defs/claim"
              },
              "additivity": {
                "$ref": "#/$defs/claim",
                "description": "Known value must source-bind claim_id, distinct_funds_receipts/disjoint_wealth_components basis, and exact distinct event_ids. Missing/unknown withholds total."
              }
            }
          }
        },
        "hypotheses": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "hypothesis_id",
              "proposition",
              "support",
              "counterevidence"
            ],
            "properties": {
              "hypothesis_id": {
                "type": "string"
              },
              "proposition": {
                "type": "string"
              },
              "support": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/claim"
                }
              },
              "counterevidence": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/claim"
                }
              }
            }
          }
        },
        "controls": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "control_id",
              "design_assessed",
              "operating_assessed",
              "assessor",
              "period_start",
              "period_end",
              "sample_size",
              "failures",
              "id_evidence"
            ],
            "properties": {
              "control_id": {
                "type": "string"
              },
              "design_assessed": {
                "$ref": "#/$defs/claim"
              },
              "operating_assessed": {
                "$ref": "#/$defs/claim"
              },
              "assessor": {
                "$ref": "#/$defs/claim"
              },
              "period_start": {
                "$ref": "#/$defs/claim"
              },
              "period_end": {
                "$ref": "#/$defs/claim"
              },
              "sample_size": {
                "$ref": "#/$defs/claim"
              },
              "failures": {
                "$ref": "#/$defs/claim"
              },
              "id_evidence": {
                "$ref": "#/$defs/claim"
              }
            }
          }
        },
        "chronology": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "date",
              "event"
            ],
            "properties": {
              "date": {
                "$ref": "#/$defs/claim"
              },
              "event": {
                "$ref": "#/$defs/claim"
              }
            }
          }
        }
      }
    },
    "method_profile": {
      "type": "object",
      "required": [
        "method",
        "version",
        "jurisdiction",
        "institution_type",
        "purpose",
        "effective_date",
        "review_due_date",
        "approval_status",
        "approval",
        "tolerance"
      ],
      "properties": {
        "method": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "jurisdiction": {
          "type": "string"
        },
        "institution_type": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "effective_date": {
          "type": "string"
        },
        "review_due_date": {
          "type": "string"
        },
        "approval_status": {
          "type": "string"
        },
        "approval": {
          "$ref": "#/$defs/claim"
        },
        "tolerance": {
          "$ref": "#/$defs/claim"
        }
      }
    },
    "mode": {
      "type": "string"
    },
    "risk_method": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "method",
        "version",
        "jurisdiction",
        "institution_type",
        "purpose",
        "effective_date",
        "review_due_date",
        "approval_status",
        "approval",
        "inherent_score",
        "control_effectiveness",
        "bands",
        "required_controls",
        "required_controls_evidence"
      ],
      "properties": {
        "method": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "jurisdiction": {
          "type": "string"
        },
        "institution_type": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "effective_date": {
          "type": "string"
        },
        "review_due_date": {
          "type": "string"
        },
        "approval_status": {
          "type": "string"
        },
        "approval": {
          "$ref": "#/$defs/claim"
        },
        "inherent_score": {
          "$ref": "#/$defs/claim"
        },
        "control_effectiveness": {
          "$ref": "#/$defs/claim"
        },
        "bands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "maximum",
              "band",
              "band_evidence"
            ],
            "properties": {
              "maximum": {
                "$ref": "#/$defs/claim"
              },
              "band": {
                "type": "string"
              },
              "band_evidence": {
                "$ref": "#/$defs/claim"
              }
            }
          }
        },
        "required_controls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_controls_evidence": {
          "$ref": "#/$defs/claim"
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "enhanced-due-diligence-assessor Phase2 input",
  "description": "Draft 2020-12 structural companion for Phase2 mode=substantive only. Native domain validation adds exact source-value, method, date, context, access and authority checks. Legacy mode uses retained legacy_validate_input.py and legacy_validate_output.py; legacy fixtures are intentionally outside this Phase2 JSON companion.",
  "$defs": {
    "claim": {
      "type": "object",
      "required": [
        "value",
        "source_refs",
        "fact_ids"
      ],
      "properties": {
        "value": {},
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fact_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
