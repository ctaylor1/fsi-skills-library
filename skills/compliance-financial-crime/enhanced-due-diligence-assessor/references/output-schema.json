{
  "type": "object",
  "required": [
    "contract_version",
    "skill",
    "method",
    "request_id",
    "object_id",
    "object_type",
    "as_of",
    "knowledge_cutoff",
    "context",
    "role",
    "classification",
    "audience",
    "status",
    "results",
    "unresolved_issues",
    "claim_bindings",
    "limitations",
    "source_refs",
    "source_assurance",
    "handoffs",
    "draft",
    "human_review_required",
    "action_taken",
    "approval",
    "execution",
    "input_hash",
    "source_truth"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "compliance-foundation/2.0"
    },
    "skill": {
      "type": "string",
      "const": "enhanced-due-diligence-assessor"
    },
    "method": {
      "type": "string",
      "const": "edd-reconciliation/1.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "object_id": {
      "type": "string",
      "minLength": 1
    },
    "object_type": {
      "type": "string",
      "const": "customer",
      "minLength": 1
    },
    "as_of": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "format": "date"
    },
    "knowledge_cutoff": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "format": "date"
    },
    "context": {
      "type": "object",
      "required": [
        "institution_id",
        "legal_entity_id",
        "capacity",
        "represented_party",
        "object_id",
        "object_type",
        "jurisdiction",
        "line_of_business",
        "purpose"
      ],
      "properties": {
        "institution_id": {
          "type": "string",
          "minLength": 1
        },
        "legal_entity_id": {
          "type": "string",
          "minLength": 1
        },
        "capacity": {
          "type": "string",
          "minLength": 1
        },
        "represented_party": {
          "type": "string",
          "minLength": 1
        },
        "object_id": {
          "type": "string",
          "minLength": 1
        },
        "object_type": {
          "type": "string",
          "minLength": 1,
          "const": "customer"
        },
        "jurisdiction": {
          "type": "string",
          "minLength": 1
        },
        "line_of_business": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "role": {
      "type": "string",
      "enum": [
        "control_operator",
        "oversight",
        "decision_support",
        "operational_qa",
        "independent_testing",
        "regulatory_affairs",
        "privacy_review"
      ]
    },
    "classification": {
      "type": "string",
      "enum": [
        "compliance_confidential",
        "customer_pii",
        "mnpi",
        "sar_restricted",
        "legal_restricted"
      ]
    },
    "audience": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "needs-evidence",
        "draft-for-human-review"
      ]
    },
    "results": {
      "type": "object",
      "required": [
        "wealth_funds_assessments",
        "chronology",
        "hypotheses",
        "control_assessments",
        "residual_risk",
        "recommendation",
        "customer_decision"
      ],
      "properties": {
        "wealth_funds_assessments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "claim_id",
              "kind",
              "currency",
              "claimed_amount",
              "corroborated_amount",
              "difference",
              "economic_event_aggregation",
              "quantitative_review",
              "plausibility",
              "economic_activity",
              "capacity_basis",
              "economic_capacity",
              "capacity_review",
              "corroboration",
              "counterevidence"
            ],
            "properties": {
              "claim_id": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "currency": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "claimed_amount": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^-?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?$",
                "description": "Exact computed decimal string; null means withheld/unknown. No floating monetary approximation."
              },
              "corroborated_amount": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^-?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?$",
                "description": "Exact computed decimal string; null means withheld/unknown. No floating monetary approximation."
              },
              "difference": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^-?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?$",
                "description": "Exact computed decimal string; null means withheld/unknown. No floating monetary approximation."
              },
              "economic_event_aggregation": {
                "type": "object",
                "required": [
                  "status",
                  "basis",
                  "unique_event_count",
                  "events"
                ],
                "properties": {
                  "status": {
                    "type": "string"
                  },
                  "basis": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "unique_event_count": {
                    "type": "integer"
                  },
                  "events": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "event_id",
                        "amount",
                        "currency",
                        "date",
                        "document_evidence_ids",
                        "consistency"
                      ],
                      "properties": {
                        "event_id": {
                          "type": "string"
                        },
                        "amount": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "pattern": "^-?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?$",
                          "description": "Exact computed decimal string; null means withheld/unknown. No floating monetary approximation."
                        },
                        "currency": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "date": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "document_evidence_ids": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "consistency": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              },
              "quantitative_review": {
                "type": "string"
              },
              "plausibility": {
                "type": "string"
              },
              "economic_activity": {
                "$ref": "#/$defs/sourceValue"
              },
              "capacity_basis": {
                "$ref": "#/$defs/sourceValue"
              },
              "economic_capacity": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^-?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?$",
                "description": "Exact computed decimal string; null means withheld/unknown. No floating monetary approximation."
              },
              "capacity_review": {
                "type": "string"
              },
              "corroboration": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "evidence_id",
                    "economic_event_id",
                    "amount",
                    "date",
                    "description",
                    "counting_status"
                  ],
                  "properties": {
                    "evidence_id": {
                      "type": "string"
                    },
                    "economic_event_id": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "amount": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "pattern": "^-?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?$",
                      "description": "Exact computed decimal string; null means withheld/unknown. No floating monetary approximation."
                    },
                    "date": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "description": {
                      "$ref": "#/$defs/sourceValue"
                    },
                    "counting_status": {
                      "type": "string"
                    }
                  }
                }
              },
              "counterevidence": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/sourceValue"
                }
              }
            }
          }
        },
        "chronology": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "date",
              "event"
            ],
            "properties": {
              "date": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "event": {
                "$ref": "#/$defs/sourceValue"
              }
            }
          }
        },
        "hypotheses": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "hypothesis_id",
              "proposition",
              "proposition_status",
              "support",
              "counterevidence",
              "conclusion"
            ],
            "properties": {
              "hypothesis_id": {
                "type": "string"
              },
              "proposition": {
                "type": "string"
              },
              "proposition_status": {
                "type": "string"
              },
              "support": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/sourceValue"
                }
              },
              "counterevidence": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/sourceValue"
                }
              },
              "conclusion": {
                "type": "string"
              }
            }
          }
        },
        "control_assessments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "control_id",
              "design_assessed",
              "operating_assessed",
              "assessor",
              "period_start",
              "period_end",
              "sample_size",
              "failures",
              "operating_assessment_supported"
            ],
            "properties": {
              "control_id": {
                "type": "string"
              },
              "design_assessed": {
                "$ref": "#/$defs/sourceValue"
              },
              "operating_assessed": {
                "$ref": "#/$defs/sourceValue"
              },
              "assessor": {
                "$ref": "#/$defs/sourceValue"
              },
              "period_start": {
                "$ref": "#/$defs/sourceValue"
              },
              "period_end": {
                "$ref": "#/$defs/sourceValue"
              },
              "sample_size": {
                "$ref": "#/$defs/sourceValue"
              },
              "failures": {
                "$ref": "#/$defs/sourceValue"
              },
              "operating_assessment_supported": {
                "type": "boolean"
              }
            }
          }
        },
        "residual_risk": {
          "type": "object",
          "required": [
            "band",
            "score",
            "status"
          ],
          "properties": {
            "band": {
              "type": "string"
            },
            "score": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^-?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?$",
              "description": "Exact computed decimal string; null means withheld/unknown. No floating monetary approximation."
            },
            "status": {
              "type": "string"
            }
          }
        },
        "recommendation": {
          "type": "string",
          "const": "human-adjudication-required"
        },
        "customer_decision": {
          "type": "string",
          "const": "human-owned"
        }
      }
    },
    "unresolved_issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "claim_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "native_input_pointer",
          "source_refs",
          "fact_ids",
          "consistency",
          "issues"
        ],
        "properties": {
          "native_input_pointer": {
            "type": "string"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fact_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "consistency": {
            "type": "string"
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_assurance": {
      "type": "string",
      "const": "supplied-unverified"
    },
    "handoffs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "draft": {
      "type": "boolean",
      "const": true
    },
    "human_review_required": {
      "type": "boolean",
      "const": true
    },
    "action_taken": {
      "type": "boolean",
      "const": false
    },
    "approval": {
      "type": "string",
      "const": "not_requested"
    },
    "execution": {
      "type": "string",
      "const": "not_performed"
    },
    "input_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_truth": {
      "type": "string",
      "const": "unverified"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "enhanced-due-diligence-assessor Phase2 output",
  "description": "Draft 2020-12 result companion for Phase2 mode=substantive only. Source observations preserve their actual JSON type; computed monetary/boolean fields admit explicit unknowns. Core context and nonaction constraints remain strict. Exact detached native reconstruction is authoritative. Legacy mode uses retained legacy validators and is intentionally outside this Phase2 JSON companion.",
  "additionalProperties": false,
  "$defs": {
    "sourceValue": {
      "type": [
        "null",
        "boolean",
        "object",
        "array",
        "number",
        "string"
      ],
      "description": "Exact resolved supplied source-value observation, retaining its actual JSON type. Null is unknown/withheld. This value is not authenticated or a professional decision."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "classification": {
            "const": "sar_restricted"
          }
        },
        "required": [
          "classification"
        ]
      },
      "then": {
        "properties": {
          "audience": {
            "const": "authorized_fiu"
          }
        }
      }
    }
  ]
}
