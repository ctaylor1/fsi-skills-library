{
  "type": "object",
  "required": [
    "contract_version",
    "skill",
    "method",
    "request_id",
    "object_id",
    "object_type",
    "as_of",
    "knowledge_cutoff",
    "context",
    "role",
    "classification",
    "audience",
    "status",
    "results",
    "unresolved_issues",
    "claim_bindings",
    "limitations",
    "source_refs",
    "source_assurance",
    "handoffs",
    "draft",
    "human_review_required",
    "action_taken",
    "approval",
    "execution",
    "input_hash",
    "source_truth"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "compliance-foundation/2.0"
    },
    "skill": {
      "type": "string",
      "const": "customer-due-diligence-reviewer"
    },
    "method": {
      "type": "string",
      "const": "cdd-lifecycle/1.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "object_id": {
      "type": "string",
      "minLength": 1
    },
    "object_type": {
      "type": "string",
      "const": "customer",
      "minLength": 1
    },
    "as_of": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "format": "date"
    },
    "knowledge_cutoff": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "format": "date"
    },
    "context": {
      "type": "object",
      "required": [
        "institution_id",
        "legal_entity_id",
        "capacity",
        "represented_party",
        "object_id",
        "object_type",
        "jurisdiction",
        "line_of_business",
        "purpose"
      ],
      "properties": {
        "institution_id": {
          "type": "string",
          "minLength": 1
        },
        "legal_entity_id": {
          "type": "string",
          "minLength": 1
        },
        "capacity": {
          "type": "string",
          "minLength": 1
        },
        "represented_party": {
          "type": "string",
          "minLength": 1
        },
        "object_id": {
          "type": "string",
          "minLength": 1
        },
        "object_type": {
          "type": "string",
          "minLength": 1,
          "const": "customer"
        },
        "jurisdiction": {
          "type": "string",
          "minLength": 1
        },
        "line_of_business": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "role": {
      "type": "string",
      "enum": [
        "control_operator",
        "oversight",
        "decision_support",
        "operational_qa",
        "independent_testing",
        "regulatory_affairs",
        "privacy_review"
      ]
    },
    "classification": {
      "type": "string",
      "enum": [
        "compliance_confidential",
        "customer_pii",
        "mnpi",
        "sar_restricted",
        "legal_restricted"
      ]
    },
    "audience": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "needs-evidence",
        "draft-for-human-review"
      ]
    },
    "results": {
      "type": "object",
      "required": [
        "lifecycle",
        "review_due_date",
        "review_overdue",
        "material_changes",
        "current_record",
        "ownership_pct",
        "ownership_control_review",
        "unverified_owner_ids",
        "expected_activity_review",
        "observed_activity_total",
        "review_controls",
        "remediation_proposals",
        "customer_decision"
      ],
      "properties": {
        "lifecycle": {
          "type": "string"
        },
        "review_due_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "review_overdue": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "material_changes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "field",
              "prior",
              "current",
              "basis"
            ],
            "properties": {
              "field": {
                "type": "string"
              },
              "prior": {
                "$ref": "#/$defs/sourceValue"
              },
              "current": {
                "$ref": "#/$defs/sourceValue"
              },
              "basis": {
                "type": "string"
              }
            }
          }
        },
        "current_record": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/sourceValue"
          }
        },
        "ownership_pct": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^-?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?$",
          "description": "Exact computed decimal string; null means withheld/unknown. No floating monetary approximation."
        },
        "ownership_control_review": {
          "type": "string"
        },
        "unverified_owner_ids": {
          "type": "array",
          "items": {}
        },
        "expected_activity_review": {
          "type": "string"
        },
        "observed_activity_total": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^-?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?$",
          "description": "Exact computed decimal string; null means withheld/unknown. No floating monetary approximation."
        },
        "review_controls": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/sourceValue"
          }
        },
        "remediation_proposals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "proposal",
              "execution"
            ],
            "properties": {
              "proposal": {
                "type": "string"
              },
              "execution": {
                "type": "string",
                "const": "not_performed"
              }
            }
          }
        },
        "customer_decision": {
          "type": "string",
          "const": "human-owned"
        }
      }
    },
    "unresolved_issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "claim_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "native_input_pointer",
          "source_refs",
          "fact_ids",
          "consistency",
          "issues"
        ],
        "properties": {
          "native_input_pointer": {
            "type": "string"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fact_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "consistency": {
            "type": "string"
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_assurance": {
      "type": "string",
      "const": "supplied-unverified"
    },
    "handoffs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "draft": {
      "type": "boolean",
      "const": true
    },
    "human_review_required": {
      "type": "boolean",
      "const": true
    },
    "action_taken": {
      "type": "boolean",
      "const": false
    },
    "approval": {
      "type": "string",
      "const": "not_requested"
    },
    "execution": {
      "type": "string",
      "const": "not_performed"
    },
    "input_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_truth": {
      "type": "string",
      "const": "unverified"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "customer-due-diligence-reviewer Phase2 output",
  "description": "Draft 2020-12 result companion for Phase2 mode=lifecycle only. Source observations preserve their actual JSON type; computed monetary/boolean fields admit explicit unknowns. Core context and nonaction constraints remain strict. Exact detached native reconstruction is authoritative. Legacy mode uses retained legacy validators and is intentionally outside this Phase2 JSON companion.",
  "additionalProperties": false,
  "$defs": {
    "sourceValue": {
      "type": [
        "null",
        "boolean",
        "object",
        "array",
        "number",
        "string"
      ],
      "description": "Exact resolved supplied source-value observation, retaining its actual JSON type. Null is unknown/withheld. This value is not authenticated or a professional decision."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "classification": {
            "const": "sar_restricted"
          }
        },
        "required": [
          "classification"
        ]
      },
      "then": {
        "properties": {
          "audience": {
            "const": "authorized_fiu"
          }
        }
      }
    }
  ]
}
