{
  "type": "object",
  "required": [
    "request_id",
    "object_id",
    "object_type",
    "as_of",
    "knowledge_cutoff",
    "execution_context",
    "workflow",
    "sources",
    "data",
    "policy_profile",
    "mode"
  ],
  "properties": {
    "request_id": {
      "type": "string"
    },
    "object_id": {
      "type": "string"
    },
    "object_type": {
      "type": "string",
      "const": "customer"
    },
    "as_of": {
      "type": "string"
    },
    "knowledge_cutoff": {
      "type": "string"
    },
    "execution_context": {
      "type": "string"
    },
    "workflow": {
      "type": "object",
      "required": [
        "context",
        "as_of",
        "role",
        "classification",
        "audience",
        "allowed_audiences",
        "sources",
        "unresolved_issues"
      ],
      "properties": {
        "context": {
          "type": "object",
          "required": [
            "institution_id",
            "legal_entity_id",
            "capacity",
            "represented_party",
            "object_id",
            "object_type",
            "jurisdiction",
            "line_of_business",
            "purpose"
          ],
          "properties": {
            "institution_id": {
              "type": "string"
            },
            "legal_entity_id": {
              "type": "string"
            },
            "capacity": {
              "type": "string"
            },
            "represented_party": {
              "type": "string"
            },
            "object_id": {
              "type": "string"
            },
            "object_type": {
              "type": "string"
            },
            "jurisdiction": {
              "type": "string"
            },
            "line_of_business": {
              "type": "string"
            },
            "purpose": {
              "type": "string"
            }
          }
        },
        "as_of": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "classification": {
          "type": "string"
        },
        "audience": {
          "type": "string"
        },
        "allowed_audiences": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "source_ref",
              "version"
            ],
            "properties": {
              "source_ref": {
                "type": "string"
              },
              "version": {
                "type": "string"
              }
            }
          }
        },
        "unresolved_issues": {
          "type": "array",
          "items": {}
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_ref",
          "version",
          "received_at",
          "publication_date",
          "classification",
          "permitted_audiences",
          "facts"
        ],
        "properties": {
          "source_ref": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "received_at": {
            "type": "string"
          },
          "publication_date": {
            "type": "string"
          },
          "classification": {
            "type": "string"
          },
          "permitted_audiences": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "facts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "fact_id",
                "value",
                "excerpt"
              ],
              "properties": {
                "fact_id": {
                  "type": "string"
                },
                "value": {
                  "type": [
                    "null",
                    "boolean",
                    "object",
                    "array",
                    "number",
                    "string"
                  ],
                  "description": "Actual finite JSON fact value, preserving its source type; native common validation rejects nonfinite numbers."
                },
                "excerpt": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "data": {
      "type": "object",
      "required": [
        "lifecycle",
        "anchor_date",
        "prior_record",
        "current_record",
        "ownership_complete",
        "control_coverage",
        "owners",
        "expected_activity_currency",
        "expected_activity_period_start",
        "expected_activity_period_end",
        "observed_activity",
        "review_controls"
      ],
      "properties": {
        "lifecycle": {
          "type": "string"
        },
        "anchor_date": {
          "$ref": "#/$defs/claim"
        },
        "prior_record": {
          "type": "object",
          "required": [
            "business_activity",
            "customer_name"
          ],
          "properties": {
            "business_activity": {
              "$ref": "#/$defs/claim"
            },
            "customer_name": {
              "$ref": "#/$defs/claim"
            }
          }
        },
        "current_record": {
          "type": "object",
          "required": [
            "business_activity",
            "customer_name"
          ],
          "properties": {
            "business_activity": {
              "$ref": "#/$defs/claim"
            },
            "customer_name": {
              "$ref": "#/$defs/claim"
            }
          }
        },
        "ownership_complete": {
          "$ref": "#/$defs/claim"
        },
        "control_coverage": {
          "$ref": "#/$defs/claim"
        },
        "owners": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "owner_id",
              "ownership_pct",
              "verified",
              "owner_evidence"
            ],
            "properties": {
              "owner_id": {
                "type": "string"
              },
              "ownership_pct": {
                "$ref": "#/$defs/claim"
              },
              "verified": {
                "$ref": "#/$defs/claim"
              },
              "owner_evidence": {
                "$ref": "#/$defs/claim"
              }
            }
          }
        },
        "expected_activity_currency": {
          "$ref": "#/$defs/claim"
        },
        "expected_activity_period_start": {
          "$ref": "#/$defs/claim"
        },
        "expected_activity_period_end": {
          "$ref": "#/$defs/claim"
        },
        "observed_activity": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "amount",
              "date",
              "currency",
              "currency_evidence"
            ],
            "properties": {
              "amount": {
                "$ref": "#/$defs/claim"
              },
              "date": {
                "$ref": "#/$defs/claim"
              },
              "currency": {
                "type": "string"
              },
              "currency_evidence": {
                "$ref": "#/$defs/claim"
              }
            }
          }
        },
        "review_controls": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "control_id",
              "evidence"
            ],
            "properties": {
              "control_id": {
                "type": "string"
              },
              "evidence": {
                "$ref": "#/$defs/claim"
              }
            }
          }
        }
      }
    },
    "policy_profile": {
      "type": "object",
      "required": [
        "method",
        "version",
        "jurisdiction",
        "institution_type",
        "purpose",
        "effective_date",
        "review_due_date",
        "approval_status",
        "approval",
        "material_fields",
        "required_fields",
        "cadence_days",
        "ownership_coverage_target",
        "activity_min",
        "activity_max",
        "required_controls"
      ],
      "properties": {
        "method": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "jurisdiction": {
          "type": "string"
        },
        "institution_type": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "effective_date": {
          "type": "string"
        },
        "review_due_date": {
          "type": "string"
        },
        "approval_status": {
          "type": "string"
        },
        "approval": {
          "$ref": "#/$defs/claim"
        },
        "material_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cadence_days": {
          "$ref": "#/$defs/claim"
        },
        "ownership_coverage_target": {
          "$ref": "#/$defs/claim"
        },
        "activity_min": {
          "$ref": "#/$defs/claim"
        },
        "activity_max": {
          "$ref": "#/$defs/claim"
        },
        "required_controls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "mode": {
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "customer-due-diligence-reviewer Phase2 input",
  "description": "Draft 2020-12 structural companion for Phase2 mode=lifecycle only. Native domain validation adds exact source-value, method, date, context, access and authority checks. Legacy mode uses retained legacy_validate_input.py and legacy_validate_output.py; legacy fixtures are intentionally outside this Phase2 JSON companion.",
  "$defs": {
    "claim": {
      "type": "object",
      "required": [
        "value",
        "source_refs",
        "fact_ids"
      ],
      "properties": {
        "value": {},
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fact_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
