{
  "type": "object",
  "required": [
    "contract_version",
    "skill",
    "method",
    "request_id",
    "object_id",
    "object_type",
    "as_of",
    "knowledge_cutoff",
    "context",
    "role",
    "classification",
    "audience",
    "status",
    "results",
    "unresolved_issues",
    "claim_bindings",
    "limitations",
    "source_refs",
    "source_assurance",
    "handoffs",
    "draft",
    "human_review_required",
    "action_taken",
    "approval",
    "execution",
    "input_hash",
    "source_truth"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "compliance-foundation/2.0"
    },
    "skill": {
      "type": "string",
      "const": "financial-crime-case-investigator"
    },
    "method": {
      "type": "string",
      "const": "case-flow-evidence/1.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "object_id": {
      "type": "string",
      "minLength": 1
    },
    "object_type": {
      "type": "string",
      "const": "financial_crime_case",
      "minLength": 1
    },
    "as_of": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "format": "date"
    },
    "knowledge_cutoff": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "format": "date"
    },
    "context": {
      "type": "object",
      "required": [
        "institution_id",
        "legal_entity_id",
        "capacity",
        "represented_party",
        "object_id",
        "object_type",
        "jurisdiction",
        "line_of_business",
        "purpose"
      ],
      "properties": {
        "institution_id": {
          "type": "string",
          "minLength": 1
        },
        "legal_entity_id": {
          "type": "string",
          "minLength": 1
        },
        "capacity": {
          "type": "string",
          "minLength": 1
        },
        "represented_party": {
          "type": "string",
          "minLength": 1
        },
        "object_id": {
          "type": "string",
          "minLength": 1
        },
        "object_type": {
          "type": "string",
          "minLength": 1,
          "const": "financial_crime_case"
        },
        "jurisdiction": {
          "type": "string",
          "minLength": 1
        },
        "line_of_business": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "role": {
      "type": "string",
      "enum": [
        "control_operator",
        "oversight",
        "decision_support",
        "operational_qa",
        "independent_testing",
        "regulatory_affairs",
        "privacy_review"
      ]
    },
    "classification": {
      "type": "string",
      "enum": [
        "compliance_confidential",
        "customer_pii",
        "mnpi",
        "sar_restricted",
        "legal_restricted"
      ]
    },
    "audience": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "needs-evidence",
        "draft-for-human-review"
      ]
    },
    "results": {
      "type": "object",
      "required": [
        "scope",
        "entities",
        "accounts",
        "flow_links",
        "currency_totals",
        "proceeds_amount",
        "proceeds_status",
        "chronology",
        "hypotheses",
        "investigative_plan",
        "narrative_propositions",
        "disposition",
        "reportability"
      ],
      "properties": {
        "scope": {
          "type": "object",
          "required": [
            "start",
            "end",
            "currencies"
          ],
          "properties": {
            "start": {
              "type": "string"
            },
            "end": {
              "type": "string"
            },
            "currencies": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "entities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "scope_ref",
              "entity_id",
              "identity",
              "evidence_status"
            ],
            "properties": {
              "scope_ref": {
                "type": "string"
              },
              "entity_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "identity": {
                "$ref": "#/$defs/sourceValue"
              },
              "evidence_status": {
                "type": "string"
              }
            }
          }
        },
        "accounts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "scope_ref",
              "account_id",
              "entity_id",
              "identity",
              "evidence_status"
            ],
            "properties": {
              "scope_ref": {
                "type": "string"
              },
              "account_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "entity_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "identity": {
                "$ref": "#/$defs/sourceValue"
              },
              "evidence_status": {
                "type": "string"
              }
            }
          }
        },
        "flow_links": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "transaction_id",
              "from",
              "to",
              "currency",
              "amount",
              "date",
              "source_refs"
            ],
            "properties": {
              "transaction_id": {
                "type": "string"
              },
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "currency": {
                "type": "string"
              },
              "amount": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^-?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?$",
                "description": "Exact computed decimal string; null means withheld/unknown. No floating monetary approximation."
              },
              "date": {
                "type": "string"
              },
              "source_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "currency_totals": {
          "type": "object",
          "propertyNames": {
            "minLength": 1
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "external_inflow",
              "external_outflow",
              "internal_transfer",
              "unique_turnover",
              "unquantified_transactions"
            ],
            "properties": {
              "external_inflow": {
                "type": "string",
                "pattern": "^-?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?$",
                "description": "Exact computed decimal string; null means withheld/unknown. No floating monetary approximation."
              },
              "external_outflow": {
                "type": "string",
                "pattern": "^-?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?$",
                "description": "Exact computed decimal string; null means withheld/unknown. No floating monetary approximation."
              },
              "internal_transfer": {
                "type": "string",
                "pattern": "^-?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?$",
                "description": "Exact computed decimal string; null means withheld/unknown. No floating monetary approximation."
              },
              "unique_turnover": {
                "type": "string",
                "pattern": "^-?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?$",
                "description": "Exact computed decimal string; null means withheld/unknown. No floating monetary approximation."
              },
              "unquantified_transactions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "proceeds_amount": {
          "type": "null",
          "const": null
        },
        "proceeds_status": {
          "type": "string"
        },
        "chronology": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "date",
              "event"
            ],
            "properties": {
              "date": {
                "$ref": "#/$defs/sourceValue"
              },
              "event": {
                "$ref": "#/$defs/sourceValue"
              }
            }
          }
        },
        "hypotheses": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "hypothesis_id",
              "proposition",
              "proposition_status",
              "support",
              "counterevidence",
              "conclusion"
            ],
            "properties": {
              "hypothesis_id": {
                "type": "string"
              },
              "proposition": {
                "type": "string"
              },
              "proposition_status": {
                "type": "string"
              },
              "support": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/sourceValue"
                }
              },
              "counterevidence": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/sourceValue"
                }
              },
              "conclusion": {
                "type": "string"
              }
            }
          }
        },
        "investigative_plan": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "step_id",
              "question",
              "hypothesis_ids",
              "execution"
            ],
            "properties": {
              "step_id": {
                "type": "string"
              },
              "question": {
                "type": "string"
              },
              "hypothesis_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "execution": {
                "type": "string"
              }
            }
          }
        },
        "narrative_propositions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceValue"
          }
        },
        "disposition": {
          "type": "string",
          "const": "human-owned"
        },
        "reportability": {
          "type": "string",
          "const": "human-owned"
        }
      }
    },
    "unresolved_issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "claim_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "native_input_pointer",
          "source_refs",
          "fact_ids",
          "consistency",
          "issues"
        ],
        "properties": {
          "native_input_pointer": {
            "type": "string"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fact_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "consistency": {
            "type": "string"
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_assurance": {
      "type": "string",
      "const": "supplied-unverified"
    },
    "handoffs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "draft": {
      "type": "boolean",
      "const": true
    },
    "human_review_required": {
      "type": "boolean",
      "const": true
    },
    "action_taken": {
      "type": "boolean",
      "const": false
    },
    "approval": {
      "type": "string",
      "const": "not_requested"
    },
    "execution": {
      "type": "string",
      "const": "not_performed"
    },
    "input_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_truth": {
      "type": "string",
      "const": "unverified"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "financial-crime-case-investigator Phase2 output",
  "description": "Draft 2020-12 schema for the Phase2 native result. Individual source observations preserve actual typed JSON; computed monetary/boolean fields admit explicit unknowns. Core context and nonaction constraints remain strict. Exact detached reconstruction adds identity/value/method/source consistency and is authoritative. Legacy result schemas remain separate.",
  "additionalProperties": false,
  "$defs": {
    "sourceValue": {
      "type": [
        "null",
        "boolean",
        "object",
        "array",
        "number",
        "string"
      ],
      "description": "Exact resolved supplied source-value observation, retaining its actual JSON type. Null is unknown/withheld. This value is not authenticated or a professional decision."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "classification": {
            "const": "sar_restricted"
          }
        },
        "required": [
          "classification"
        ]
      },
      "then": {
        "properties": {
          "audience": {
            "const": "authorized_fiu"
          }
        }
      }
    }
  ]
}
