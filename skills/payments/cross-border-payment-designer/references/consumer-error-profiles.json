    "US-REG-E-CONSUMER-EFT": {
      "jurisdictions": [
        "US"
      ],
      "products": [
        "consumer-eft",
        "debit-card",
        "consumer-deposit"
      ],
      "rails": [
        "ACH",
        "FedNow",
        "RTP",
        "card"
      ],
      "regime": "Regulation E, 12 CFR 1005.11",
      "authority": "CFPB",
      "source_ref": "https://www.consumerfinance.gov/rules-policy/regulations/1005/11/",
      "conditions": [
        "Consumer account and covered EFT; commercial accounts and excluded wire systems require separate assessment.",
        "Timely notice generally links to statement transmission; late unauthorized notice does not automatically end liability review."
      ],
      "clock_rules": [
        {
          "name": "error-notice",
          "trigger": "statement-first-showing-error",
          "basis": "calendar-days",
          "period": 60
        },
        {
          "name": "initial-investigation",
          "trigger": "notice-received",
          "basis": "business-days",
          "period": 10
        },
        {
          "name": "extended-investigation",
          "trigger": "notice-received",
          "basis": "calendar-days",
          "period": 45
        },
        {
          "name": "results-notice",
          "trigger": "investigation-completed",
          "basis": "business-days",
          "period": 3
        },
        {
          "name": "correction",
          "trigger": "error-determined",
          "basis": "business-days",
          "period": 1
        }
      ],
      "exceptions": [
        "New-account initial investigation can be 20 business days.",
        "New-account, foreign-initiated and POS-debit cases can change extended investigation to 90 calendar days.",
        "Provisional-credit and written-confirmation conditions require case review; no credit is authorized by this profile."
      ],
      "required_action_reviews": [
        "provisional-credit-conditions",
        "written-confirmation",
        "unauthorized-transfer-liability",
        "exception-applicability"
      ],
      "profile_id": "US-REG-E-CONSUMER-EFT",
      "version": "2026-09-18.1",
      "status": "reference-only",
      "participants": [
        "issuer",
        "bank",
        "payment-provider"
      ],
      "reviewed_on": "2026-09-18",
      "review_due": "2026-10-18",
      "required_evidence_types": [
        "customer-notice",
        "transaction-record",
        "authority-record"
      ],
      "required_clock_names": [
        "error-notice",
        "initial-investigation",
        "extended-investigation",
        "results-notice",
        "correction"
      ],
      "limitations": [
        "Public source summary; national/product exceptions and case applicability require specialist review.",
        "Named calendar, cutoffs, trigger evidence and reviewed due dates are required; no automatic deadline or credit decision."
      ]
