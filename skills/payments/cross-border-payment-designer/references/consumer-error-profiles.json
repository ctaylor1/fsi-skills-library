          "period": 30
        },
        {
          "name": "resolution",
          "trigger": "notice-received",
          "basis": "billing-cycles-and-cap",
          "period": 2,
          "cap_calendar_days": 90
        }
      ],
      "exceptions": [
        "Acknowledgment exception if resolution completes within the acknowledgment period.",
