{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "bank-payment-workflow-designer request",
  "type": "object",
  "required": [
    "schema_version",
    "request_id",
    "as_of",
    "jurisdiction",
    "participant",
    "sources",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "jurisdiction": {
      "type": "string"
    },
    "participant": {
      "type": "string"
    },
    "requested_action": {
      "enum": [
        "analyze",
        "draft"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "reference",
          "as_of"
        ]
      }
    },
    "upstream_issues": {
      "type": "array"
    },
    "data": {
      "type": "object",
      "properties": {
        "requirements": {
          "type": "object"
        },
        "candidate_profile_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "access_evidence": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "timing_evidence": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "funding_evidence": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "costs": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "required": [
        "candidate_profile_ids"
      ],
      "description": "Domain validators enforce exact structural checks; missing business evidence produces explicit findings rather than invented defaults."
    }
  }
}
