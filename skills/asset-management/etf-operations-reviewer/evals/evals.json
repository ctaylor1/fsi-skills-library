      "expect_exit": 0,
      "expect_contains": [
        "\"action_taken\": false",
        "\"draft\": true",
        "\"premium_discount\": \"0.010000000000\""
      ]
    },
    {
      "id": "output-secondary_market",
      "type": "deterministic",
      "command": "python -B scripts/validate_output.py evals/files/secondary_market_expected.json --input evals/files/secondary_market_input.json",
      "expect_exit": 0,
      "expect_contains": [
        "\"errors\": []"
      ]
    },
