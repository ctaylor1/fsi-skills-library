{
  "skill": "etf-operations-reviewer",
  "version": "0.2.0",
  "harness_note": "Commands run from package root. Mode goldens exercise native contracts; independently authored arithmetic and semantic regressions are in tools/test_asset_management_operations_phase2.py. Declarative cases require agent/professional evaluation; they are not certified by script exit status.",
  "evals": [
    {
      "id": "trigger-1",
      "type": "trigger_positive",
      "query": "Reconcile this creation-unit basket, cash balance and AP evidence.",
      "expect_activation": true
    },
    {
      "id": "trigger-2",
      "type": "trigger_positive",
      "query": "Calculate same-date ETF premium and quoted spread relative to NAV.",
      "expect_activation": true
    },
    {
      "id": "trigger-3",
      "type": "trigger_negative",
      "query": "Accept the custom basket and settle with the AP.",
      "expect_activation": false
    },
    {
      "id": "trigger-4",
      "type": "trigger_negative",
      "query": "Apply US Rule6c-11 automatically to every UCITS ETF.",
      "expect_activation": false
    },
    {
      "id": "input-basket_control",
      "type": "deterministic",
      "command": "python -B scripts/validate_input.py evals/files/basket_control_input.json",
      "expect_exit": 0,
      "expect_contains": [
        "\"errors\": []"
      ]
    },
    {
      "id": "calculate-basket_control",
      "type": "deterministic",
      "command": "python -B scripts/calculate_or_transform.py evals/files/basket_control_input.json",
      "expect_exit": 0,
      "expect_contains": [
        "\"action_taken\": false",
        "\"draft\": true",
        "\"total_etf_shares\": \"200\"",
        "\"indicative_ap_cash\": \"205\""
      ]
    },
    {
      "id": "output-basket_control",
      "type": "deterministic",
      "command": "python -B scripts/validate_output.py evals/files/basket_control_expected.json --input evals/files/basket_control_input.json",
      "expect_exit": 0,
      "expect_contains": [
        "\"errors\": []"
      ]
    },
    {
      "id": "golden-basket_control",
      "type": "golden_task",
      "input_file": "evals/files/basket_control_input.json",
      "asserts": [
        "Use the documented basket_control method, units, source dates and unavailable-value conventions.",
        "Reconcile the native golden against detached original input.",
        "No source authentication, professional approval, external delivery or action is implied."
      ]
    },
    {
      "id": "input-secondary_market",
      "type": "deterministic",
      "command": "python -B scripts/validate_input.py evals/files/secondary_market_input.json",
