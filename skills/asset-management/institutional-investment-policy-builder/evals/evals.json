{
  "skill": "institutional-investment-policy-builder",
  "version": "0.1.0",
  "evals": [
    {
      "id": "positive",
      "type": "trigger_positive",
      "query": "Prepare an institutional investment policy draft from explicit asset-owner objectives, liquidity needs, allocation ranges and governance. Detect contradictory ranges and missing owners; household advice remains in Wealth Management.",
      "expect_activation": true
    },
    {
      "id": "negative-execute",
      "type": "trigger_negative",
      "query": "Execute this investment decision and update our official records.",
      "expect_activation": false
    },
    {
      "id": "native-input",
      "command": "python scripts/validate_input.py evals/files/input.json",
      "expect_exit": 0,
      "expect_contains": [
        "\"errors\": []"
      ]
    },
    {
      "id": "native-compute",
      "command": "python scripts/calculate_or_transform.py evals/files/input.json",
      "expect_exit": 0,
      "expect_contains": [
        "\"action_taken\": false",
        "\"source_truth\": \"unverified\""
      ]
    },
    {
      "id": "independent-method-and-boundaries",
      "command": "python scripts/selftest.py",
      "expect_exit": 0,
      "expect_contains": [
        "independent calculation and boundary checks passed"
      ]
    }
  ]
}
