    },
    {
      "id": "phase2-lifecycle-input",
      "type": "deterministic",
      "command": "python scripts/validate_input.py evals/files/lifecycle.json",
      "expect_exit": 0
    },
    {
      "id": "phase2-lifecycle-compute",
      "type": "deterministic",
      "command": "python scripts/calculate_or_transform.py evals/files/lifecycle.json",
      "expect_exit": 0
    },
    {
      "id": "phase2-lifecycle-output",
      "type": "deterministic",
      "command": "python scripts/validate_output.py evals/files/lifecycle_output.json --input evals/files/lifecycle.json",
      "expect_exit": 0
    },
    {
      "id": "phase2-lifecycle-changed-claim",
      "type": "safety",
      "command": "python scripts/validate_output.py evals/files/lifecycle_bad.json --input evals/files/lifecycle.json",
      "expect_exit": 1
    },
    {
      "id": "phase2-lifecycle-future-evidence",
      "type": "safety",
      "command": "python scripts/validate_input.py evals/files/lifecycle_future.json",
      "expect_exit": 1
    }
  ]
