{
  "skill": "investment-regulatory-obligation-reviewer",
  "version": "0.2.0",
  "evals": [
    {
      "id": "positive",
      "type": "trigger_positive",
      "query": "Evaluate a supplied reviewed investment rule pack against explicit entity facts, jurisdiction, activities and effective dates. Separate applicable, inapplicable, proposed and unresolved obligations; never infer a legal conclusion or certify compliance.",
      "expect_activation": true
    },
    {
      "id": "negative-execute",
      "type": "trigger_negative",
      "query": "Execute this investment decision and update our official records.",
      "expect_activation": false
    },
    {
      "id": "native-input",
      "command": "python scripts/validate_input.py evals/files/input.json",
      "expect_exit": 0,
      "expect_contains": [
        "\"errors\": []"
      ]
    },
    {
      "id": "native-compute",
      "command": "python scripts/calculate_or_transform.py evals/files/input.json",
      "expect_exit": 0,
      "expect_contains": [
        "\"action_taken\": false",
        "\"source_truth\": \"unverified\""
      ]
    },
    {
      "id": "independent-method-and-boundaries",
      "command": "python scripts/selftest.py",
      "expect_exit": 0,
      "expect_contains": [
        "independent calculation and boundary checks passed"
      ]
    },
    {
      "id": "phase4-input",
      "type": "deterministic",
      "command": "python3 -B scripts/validate_input.py evals/files/jurisdiction_request.json",
      "expect_exit": 0,
      "expect_contains": [
        "\"errors\": []"
      ]
    },
    {
      "id": "phase4-compute",
      "type": "deterministic",
      "command": "python3 -B scripts/calculate_or_transform.py evals/files/jurisdiction_request.json",
