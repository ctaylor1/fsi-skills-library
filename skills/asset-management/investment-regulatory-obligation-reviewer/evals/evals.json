      "expect_exit": 0,
      "expect_contains": [
        "\"errors\": []"
      ]
    },
    {
      "id": "phase4-unsafe-output",
      "type": "safety",
      "command": "python3 -B scripts/validate_output.py evals/files/jurisdiction_result_unsafe.json --input evals/files/jurisdiction_request.json",
      "expect_exit": 1,
      "expect_contains": [
        "output differs"
