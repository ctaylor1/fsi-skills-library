{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Supplied Insurance review records; not authenticated approvals",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "insurance-review-records/1.0"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "record_id": {
            "type": "string",
            "minLength": 1
          },
          "package": {
            "type": "string",
            "minLength": 1
          },
          "gate": {
            "enum": [
              "specification",
              "scope-routing",
              "sources",
              "tools",
              "safety-compliance",
              "quality",
              "evaluations",
              "human-acceptance",
              "operations"
            ]
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "scope": {
            "type": "object",
            "properties": {
              "institution": {
                "type": "string",
                "minLength": 1
              },
              "environment": {
                "type": "string",
                "minLength": 1
              },
              "market": {
                "type": "string",
                "minLength": 1
              },
              "program": {
                "type": "string",
                "minLength": 1
              },
              "product": {
                "type": "string",
                "minLength": 1
              },
              "jurisdiction": {
                "type": "string",
                "minLength": 1
              },
              "method": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "institution",
              "environment",
              "market",
              "program",
              "product",
              "jurisdiction",
              "method"
            ],
            "additionalProperties": false
          },
          "reviewer": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "type": "string",
                "minLength": 1
              },
              "authority_basis": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "name",
              "role",
              "authority_basis"
            ],
            "additionalProperties": false
          },
          "reviewed_on": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "effective_from": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "expires_on": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "decision": {
            "enum": [
              "accepted",
              "rejected",
              "needs-work",
              "not-applicable"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "evidence_kind": {
            "enum": [
              "institutional",
              "synthetic",
              "unknown"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "path",
                "sha256",
                "locator"
              ],
              "additionalProperties": false
            }
          },
          "unresolved_issues": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "record_id",
          "package",
          "gate",
          "content_sha256",
          "scope",
          "reviewer",
          "reviewed_on",
          "effective_from",
          "expires_on",
          "decision",
          "rationale",
          "evidence_kind",
          "evidence",
          "unresolved_issues"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "records"
  ],
  "additionalProperties": false,
  "description": "Native checker also verifies known package/gate identity, scope equality, package/evidence digests, local path containment, semantic dates and unresolved/conflicting records. No decision is authenticated or executed."
}
