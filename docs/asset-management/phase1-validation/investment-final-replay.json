se['output_validation_errors']==[]\n        outputs[case['case_id']]=actual\nm=outputs['mandate-base']\nassert {(a['rule_id'],a['breach_type']):a['measured_pct'] for a in m['alerts']}=={('ALPHA-MAX','position'):12.,('ALPHA-MAX','pre_trade'):15.,('CASH-MIN','position'):10.,('CASH-MIN','pre_trade'):8.}\nassert m['summary']['breach']==4 and m['summary']['stale_portfolios']==[]\nassert {r['rule_id']:r['status'] for r in m['rule_results']}=={'ALPHA-MAX':'exception','CASH-MIN':'exception','BETA-MAX':'pass','REG-METHOD':'not_evaluable','FUTURE':'not_applicable','OTHER-MANDATE':'not_applicable'}\nassert outputs['mandate-missing-classification']['rule_results'][0]['status']=='not_evaluable'\nx=outputs['exposure-base']\nfor dim,expected in [('issuer',{'US Treasury':35.,'Custodian':10.,'Alpha':27.,'Beta':4.,'Corp':20.,'UNKNOWN':4.}),('country',{'US':80.,'GB':12.,'CH':4.,'UNKNOWN':4.})]:\n    assert {r['bucket']:r['pct'] for r in x['exposures'][dim]}==expected\n    assert sum(r['market_value'] for r in x['exposures'][dim])==100_000_000\n    assert math.isclose(x['dimension_coverage'][dim]['unknown_market_value'],4_000_000)\nassert x['nav_reconciliation']['reconciled']\nassert {r['bucket']:r['pct'] for r in x['exposures']['asset_class']}=={'govt_bond':35.,'cash':10.,'fund':20.,'equity':15.,'corp_bond':20.}\nassert x['exposures']['liquidity']['illiquid_pct'] is None\nassert x['exposures']['liquidity']['known_illiquid_pct']==20.\nassert x['exposures']['duration']['missing_duration_position_ids']==['CORP']\nassert x['exposures']['duration']['portfolio_duration_contribution']==2.1\nassert not any(f['dimension'] in ('liquidity','duration') or (f['dimension']=='issuer' and f['bucket'] in ('US Treasury','Custodian')) for f in x['findings'])\nr=outputs['exposure-nav-residual']\nassert r['nav_reconciliation']['difference']==-5_000_000 and not r['nav_reconciliation']['reconciled']\nassert sum(v['market_value'] for v in r['exposures']['issuer'])==100_000_000\nassert any(v['dimension']=='na