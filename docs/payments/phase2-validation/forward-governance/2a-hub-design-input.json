        "authoritative_component": "ledger",
        "state_values": [
          "pending",
          "posted",
          "linked-reversal"
        ],
        "source_ids": [
          "architecture-doc"
        ]
      }
    ],
    "flows": [
      {
        "flow_id": "accept",
        "stage": "initiation",
        "from_component": "api",
        "to_component": "hub",
        "state_entity": "instruction",
        "mutates_money": false,
        "source_ids": [
          "architecture-doc"
        ]
      },
      {
