        "to_component": "network",
        "state_entity": "network-payment",
        "mutates_money": true,
        "source_ids": [
          "architecture-doc"
        ],
        "idempotency": {
          "key_fields": [
            "legal_entity_id",
            "instruction_id"
          ],
          "scope": "same legal entity and instruction across every retry/attempt",
          "retention": "30 days and until all uncertain attempts resolve",
          "atomic_enforcement": "Persist key+request digest atomically before dispatch; unique constraint on entity+instruction",
          "payload_conflict_behavior": "reject-conflict",
          "source_ids": [
            "control-doc"
          ]
        },
        "uncertain_outcome": {
