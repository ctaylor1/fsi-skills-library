  "data": {
    "context": {
      "business_flow": "Bank outbound USD instant credit transfers through hub into rail with operational journal and independent network status.",
      "current_constraint": "Current API retries on timeout, sometimes with a new attempt ID; network outcome can be unknown.",
      "target_outcome": "Reduce uncertain duplicate attempts while preserving traceable rail and ledger outcomes.",
      "module": "hub",
      "source_ids": [
        "architecture-doc"
      ]
    },
    "components": [
      {
        "component_id": "api",
        "role": "Accept client requests and correlate attempts",
        "owner": "Channels",
        "source_ids": [
          "architecture-doc"
        ]
      },
      {
        "component_id": "hub",
        "role": "Own instruction lifecycle and enforce one financial writer",
        "owner": "Payments Engineering",
        "source_ids": [
          "architecture-doc"
        ]
      },
      {
        "component_id": "ledger",
        "role": "Operational double-entry journal; does not establish rail finality",
        "owner": "Finance Operations",
        "source_ids": [
          "architecture-doc"
        ]
      },
      {
        "component_id": "network",
        "role": "Authoritative network status feed for rail acceptance and settlement",
        "owner": "Network Operations",
        "source_ids": [
          "architecture-doc"
        ]
      },
      {
        "component_id": "legacy",
        "role": "Existing legacy hub financial executor during migration",
        "owner": "Payments Engineering",
        "source_ids": [
          "architecture-doc"
        ]
      }
    ],
