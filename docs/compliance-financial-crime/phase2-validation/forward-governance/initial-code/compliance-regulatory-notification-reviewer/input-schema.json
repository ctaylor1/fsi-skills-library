{
  "type": "object",
  "required": [
    "request_id",
    "object_id",
    "object_type",
    "as_of",
    "knowledge_cutoff",
    "execution_context",
    "workflow",
    "sources",
    "data",
    "method_profile"
  ],
  "properties": {
    "request_id": {
      "type": "string"
    },
    "object_id": {
      "type": "string"
    },
    "object_type": {
      "type": "string",
      "const": "regulatory_notification"
    },
    "as_of": {
      "type": "string"
    },
    "knowledge_cutoff": {
      "type": "string"
    },
    "execution_context": {
      "type": "string"
    },
    "workflow": {
      "type": "object",
      "required": [
        "context",
        "as_of",
        "role",
        "classification",
        "audience",
        "allowed_audiences",
        "sources",
        "unresolved_issues"
      ],
      "properties": {
        "context": {
          "type": "object",
          "required": [
            "institution_id",
            "legal_entity_id",
            "capacity",
            "represented_party",
            "object_id",
            "object_type",
            "jurisdiction",
            "line_of_business",
            "purpose"
          ],
          "properties": {
            "institution_id": {
              "type": "string"
            },
            "legal_entity_id": {
              "type": "string"
            },
            "capacity": {
              "type": "string"
            },
            "represented_party": {
              "type": "string"
            },
            "object_id": {
              "type": "string"
            },
            "object_type": {
              "type": "string"
            },
            "jurisdiction": {
              "type": "string"
            },
            "line_of_business": {
              "type": "string"
            },
            "purpose": {
              "type": "string"
            }
          }
        },
        "as_of": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "classification": {
          "type": "string"
        },
        "audience": {
          "type": "string"
        },
        "allowed_audiences": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "source_ref",
              "version"
            ],
            "properties": {
              "source_ref": {
                "type": "string"
              },
              "version": {
                "type": "string"
              }
            }
          }
        },
        "unresolved_issues": {
          "type": "array",
          "items": {}
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_ref",
          "version",
          "received_at",
          "publication_date",
          "classification",
          "permitted_audiences",
          "facts"
        ],
        "properties": {
          "source_ref": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "received_at": {
            "type": "string"
          },
          "publication_date": {
            "type": "string"
          },
          "classification": {
            "type": "string"
          },
          "permitted_audiences": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "facts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "fact_id",
                "value",
                "excerpt"
              ],
              "properties": {
                "fact_id": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                },
                "excerpt": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "data": {
      "type": "object",
      "required": [
        "regulated_entity",
        "regulated_activity",
        "event",
        "event_date",
        "awareness_date",
        "obligations",
        "exhibits"
      ],
      "properties": {
        "regulated_entity": {
          "$ref": "#/$defs/claim"
        },
        "regulated_activity": {
          "$ref": "#/$defs/claim"
        },
        "event": {
          "$ref": "#/$defs/claim"
        },
        "event_date": {
          "$ref": "#/$defs/claim"
        },
        "awareness_date": {
          "$ref": "#/$defs/claim"
        },
        "obligations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "obligation_id",
              "entity",
              "activity",
              "rule",
              "channel",
              "due_date",
              "timing",
              "materiality_method",
              "criteria",
              "timing_evidence",
              "materiality_method_evidence"
            ],
            "properties": {
              "obligation_id": {
                "type": "string"
              },
              "entity": {
                "$ref": "#/$defs/claim"
              },
              "activity": {
                "$ref": "#/$defs/claim"
              },
              "rule": {
                "$ref": "#/$defs/claim"
              },
              "channel": {
                "$ref": "#/$defs/claim"
              },
              "due_date": {
                "$ref": "#/$defs/claim"
              },
              "timing": {
                "type": "string"
              },
              "materiality_method": {
                "type": "string"
              },
              "criteria": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "criterion_id",
                    "observed",
                    "expected"
                  ],
                  "properties": {
                    "criterion_id": {
                      "type": "string"
                    },
                    "observed": {
                      "$ref": "#/$defs/claim"
                    },
                    "expected": {
                      "$ref": "#/$defs/claim"
                    }
                  }
                }
              },
              "timing_evidence": {
                "$ref": "#/$defs/claim"
              },
              "materiality_method_evidence": {
                "$ref": "#/$defs/claim"
              }
            }
          }
        },
        "exhibits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          }
        }
      }
    },
    "method_profile": {
      "type": "object",
      "required": [
        "method",
        "version",
        "jurisdiction",
        "institution_type",
        "purpose",
        "effective_date",
        "review_due_date",
        "approval_status",
        "approval"
      ],
      "properties": {
        "method": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "jurisdiction": {
          "type": "string"
        },
        "institution_type": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "effective_date": {
          "type": "string"
        },
        "review_due_date": {
          "type": "string"
        },
        "approval_status": {
          "type": "string"
        },
        "approval": {
          "$ref": "#/$defs/claim"
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "compliance-regulatory-notification-reviewer Phase2 input",
  "description": "Structural companion; native domain validator adds exact values, enums, methods, date/context/authority/access checks. Legacy CDD/EDD schema remains separate.",
  "$defs": {
    "claim": {
      "type": "object",
      "required": [
        "value",
        "source_refs",
        "fact_ids"
      ],
      "properties": {
        "value": {},
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fact_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
